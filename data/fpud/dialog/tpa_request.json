{
  "type": "minecraft:confirmation",
  "title": {
    "text": "Tpa",
    "color": "#121111",
    "hover_event": {
      "action": "show_text",
      "value": "Teleport to another player if they allow you to"
    }
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "name",
      "label": "Name of player you wish to Teleport to"
    }
  ],
  "can_close_with_escape": false,
  "after_action": "close",
  "yes": {
    "label": "Send Request",
    "action": {
      "type": "minecraft:dynamic/run_command",
      "template": ""
    }
  },
  "no": {
    "label": "Nevermind/Exit Dialog",
    "action": {
      "type": "minecraft:run_command",
      "template": "trigger tpa set 0"
    }
  }
}
