{
  "type": "minecraft:confirmation",
  "title": {
    "text": "Tpa Request",
    "color": "#a70112"
  },
  "inputs": [],
  "can_close_with_escape": true,
  "after_action": "close",
  "yes": {
    "label": "Accept Tpa",
    "action": {
      "type": "minecraft:dynamic/run_command",
      "template": "execute as @s run tp @e[predicate=fpud:match_id] @s"
    }
  },
  "no": {
    "label": "Deny Tpa",
    "action": {
      "type": "minecraft:dynamic/run_command",
      "template": "execute as @s run tellraw @e[predicate=fpud:match_id] {\"text\":\"Your Tpa request was denied.\""
    }
  }
}
